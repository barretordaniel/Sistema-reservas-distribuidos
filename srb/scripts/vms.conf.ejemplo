# Copie este archivo a scripts/vms.conf (cp scripts/vms.conf.ejemplo scripts/vms.conf) y ponga las IP REALES.
# Cada línea es un valor de shell: sin espacios alrededor del "=". Este archivo se usa desde VM1 (el generador).

USUARIO=ubuntu                  # usuario de ssh en las otras VMs (el mismo en todas)
RUTA=/home/ubuntu/srb           # carpeta del proyecto, IGUAL en todas las VMs (ya compilada con make)

IP_GT=10.0.0.12                 # VM2: GT principal + cancelaciones
IP_BD=10.0.0.13                 # VM3: PostgreSQL + persistencia
IP_VM4=10.0.0.14                # VM4: RMC "vm4" + GT de relevo
IP_VM5=10.0.0.15                # VM5: RMC "vm5"

# Opcional (valores por defecto entre paréntesis)
# CLIENTES="3 5 8"   REPS=1   DUR=60 (segundos medidos)   CAL=10 (calentamiento)
# HILOS_BD=4   HILOS_RMC=2   ASIENTOS=5000   ELASTICA_S=25

# --- Topología de 3 VMs (VM1 carga, VM2 BD, VM3 TODA la capa lógica): descomente y ponga las IP reales
# IP_GT=<IP de VM3>   IP_BD=<IP de VM2>   IP_VM4=<IP de VM3>   IP_VM5=<IP de VM3>
# ET_GT="VM3-logica"  ET_BD="VM2-BD"      ET_VM4=""            ET_VM5=""            ET_GEN="VM1-carga"
# CLIENTES_PROC=8   (clientes en 'prueba_empirica.sh procedimientos')

# --- Si cada VM es la cuenta de una persona distinta (otro usuario y/u otra carpeta), añada solo lo que difiera:
# USUARIO_GT=...   RUTA_GT=/home/.../srb      (VM3: GT + RMC base + cancelaciones)
# USUARIO_BD=...   RUTA_BD=/home/.../srb      (VM2: PostgreSQL + persistencia)
# USUARIO_VM4=...  RUTA_VM4=/home/.../srb     (VM4: RMC nivel 2)
# USUARIO_VM5=...  RUTA_VM5=/home/.../srb     (VM5: RMC nivel 3)
# Use IP numéricas (no nombres): los RMC de VM4/VM5 se conectan a VM3 y VM2 con esas direcciones.
